rules_version = '2';

// Mental Math Lab: Firestore security rules
// 1. Replace PASTE_YOUR_ADMIN_UID_HERE below with your admin User UID.
// 2. Paste this whole file into Firebase console → Firestore Database → Rules, then click Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() { return request.auth != null && request.auth.uid == 'PASTE_YOUR_ADMIN_UID_HERE'; }
    function isSelf(uid) { return request.auth != null && request.auth.uid == uid; }
    function student(uid) { return get(/databases/$(database)/documents/students/$(uid)).data; }

    // Site settings (site open/locked, Arcade open/locked, lock message). Only the admin can change them.
    match /site/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // Students can only save while the site is open. After the teacher locks it,
    // there's a 3 minute grace period so runs that were in progress still save.
    function siteOpen() {
      let path = /databases/$(database)/documents/site/settings;
      return !exists(path)
          || get(path).data.get('open', true) != false
          || request.time < get(path).data.changedAt + duration.value(3, 'm');
    }

    // Boss drawings (pictures uploaded by the teacher, one per boss). Anyone signed in can see them.
    match /bosses/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Student profiles (name, username, grade). Only the admin can change them.
    match /students/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Student passwords, so the teacher can look them up. Admin only.
    match /secrets/{uid} {
      allow read, write: if isAdmin();
    }

    // Progress: stars, XP, coins, ship items. Students can save their own,
    // but XP can't go down and coins/XP can't jump by huge amounts in one save.
    match /progress/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin() || (isSelf(uid) && request.resource.data.xp == 0 && request.resource.data.coins == 0);
      allow update: if isAdmin() || (isSelf(uid) && siteOpen() && validProgress());
      allow delete: if isAdmin();
    }
    function validProgress() {
      let d = request.resource.data;
      let o = resource.data;
      return d.coins is int && d.coins >= 0 && d.coins <= o.coins + 2000
          && d.xp is int && d.xp >= o.xp && d.xp <= o.xp + 500;
    }

    // Friends name list: people/{uid} holds a student's username (lowercase), name, grade, ship, and
    // when they were last on the site. Students can look up one username at a time, but can't list everyone.
    match /people/{uid} {
      allow get: if request.auth != null;
      allow list: if isAdmin() || (request.auth != null && request.query.limit <= 1);
      allow create: if isAdmin() || (isSelf(uid) && validPerson(uid));
      allow update: if isAdmin() || (isSelf(uid) && (onlyCheckIn() || validPerson(uid)));
      allow delete: if isAdmin();
    }
    // A student's entry has to match their real profile
    function validPerson(uid) {
      let s = student(uid);
      let d = request.resource.data;
      return d.keys().hasOnly(['username', 'name', 'grade', 'avatar', 'seen'])
          && d.username == s.username.lower() && d.name == s.displayName && d.grade == s.grade
          && d.avatar is map && d.avatar.size() <= 8
          && d.seen == request.time;
    }
    // The "I'm online" check-in only changes the time
    function onlyCheckIn() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
          && request.resource.data.seen == request.time;
    }

    // Friendships: friends/{uidA_uidB} (the two ids in alphabetical order).
    // Only the two students (and the admin) can see one. A student can send a request as themselves,
    // only the other student can accept or decline it, and either friend can remove an accepted friendship.
    match /friends/{id} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid in id.split('_'));
      allow list: if isAdmin() || (request.auth != null && request.auth.uid in resource.data.users);
      allow create: if isAdmin() || (request.auth != null && validNewFriend(id));
      allow update: if isAdmin() || (request.auth != null && validAnswer());
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid in resource.data.users
                                     && resource.data.status == 'accepted');
    }
    function validNewFriend(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['users', 'from', 'to', 'status', 'at'])
          && d.from == request.auth.uid && d.status == 'pending' && d.at == request.time
          && d.to is string && d.to != d.from
          && id == (d.from < d.to ? d.from + '_' + d.to : d.to + '_' + d.from)
          && d.users == id.split('_')
          && exists(/databases/$(database)/documents/students/$(d.from))
          && exists(/databases/$(database)/documents/students/$(d.to));
    }
    function validAnswer() {
      let d = request.resource.data;
      return resource.data.to == request.auth.uid
          && resource.data.status != 'accepted'
          && d.diff(resource.data).affectedKeys().hasOnly(['status', 'at'])
          && d.status in ['accepted', 'declined']
          && d.at == request.time;
    }

    // Weekly leaderboards: weeks/{week}/{g6|g7|g8|school}/{uid}
    match /weeks/{week}/{board}/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (isSelf(uid) && siteOpen() && validEntry(board, uid, 3000));
    }

    // All-time leaderboards: alltime/{g6|g7|g8|school}/players/{uid}
    match /alltime/{board}/players/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (isSelf(uid) && siteOpen() && validEntry(board, uid, 50000));
    }

    // A student can only post under their own name, in their own grade's board,
    // with believable numbers.
    function validEntry(board, uid, maxXp) {
      let s = student(uid);
      let d = request.resource.data;
      return d.name == s.displayName
          && (board == 'school' || board == 'g' + string(s.grade))
          && d.keys().hasOnly(['name', 'avatar', 'grade', 'xp', 'answered', 'correct', 'improve',
                               'lane', 'blast', 'total', 'line', 'target'])
          && (!('xp' in d) || (d.xp is int && d.xp >= 0 && d.xp <= maxXp))
          && (!('improve' in d) || (d.improve is number && d.improve <= 100))
          && okScore(d, 'lane') && okScore(d, 'blast') && okScore(d, 'total') && okScore(d, 'line') && okScore(d, 'target');
    }
    // Arcade scores, one per game
    function okScore(d, k) {
      return !(k in d) || (d[k] is int && d[k] >= 0 && d[k] <= 100000);
    }
  }
}
